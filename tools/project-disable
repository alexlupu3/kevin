#!/usr/bin/env bash
set -euo pipefail

DOMAIN_BASE="alexlupu.dev"

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        echo "project-disable must run as root." >&2
        exit 1
    fi
}

validate_args() {
    if [[ "$#" -ne 1 ]]; then
        echo "Usage: project-disable <project-name>" >&2
        exit 1
    fi

    PROJECT="$1"

    if [[ ! "${PROJECT}" =~ ^[a-z0-9-]+$ ]]; then
        echo "Project name must contain only lowercase letters, digits, and hyphens." >&2
        exit 1
    fi
}

prepare_paths() {
    DOMAIN="${PROJECT}.${DOMAIN_BASE}"
    SITE_AVAILABLE="/etc/nginx/sites-available/${DOMAIN}"
    SITE_ENABLED="/etc/nginx/sites-enabled/${DOMAIN}"
}

validate_prereqs() {
    if [[ ! -f "${SITE_AVAILABLE}" ]]; then
        echo "Project config not found: ${SITE_AVAILABLE}" >&2
        exit 1
    fi

    if [[ ! -L "${SITE_ENABLED}" ]]; then
        echo "Project is not currently enabled: ${DOMAIN}" >&2
        exit 1
    fi

    if [[ "$(readlink -f "${SITE_ENABLED}")" != "${SITE_AVAILABLE}" ]]; then
        echo "Refusing to disable unexpected symlink target: ${SITE_ENABLED}" >&2
        exit 1
    fi
}

disable_site() {
    rm -f "${SITE_ENABLED}"
}

validate_and_reload_nginx() {
    nginx -t
    systemctl reload nginx
}

cleanup_on_error() {
    if [[ ! -L "${SITE_ENABLED}" ]]; then
        ln -s "${SITE_AVAILABLE}" "${SITE_ENABLED}"
    fi
}

main() {
    require_root
    validate_args "$@"
    prepare_paths
    validate_prereqs
    trap cleanup_on_error ERR
    disable_site
    validate_and_reload_nginx
    trap - ERR

    cat <<EOF
Project disabled successfully.
- project: ${PROJECT}
- domain: ${DOMAIN}
- disabled config: ${SITE_ENABLED}
- retained config: ${SITE_AVAILABLE}
EOF
}

main "$@"
