#!/usr/bin/env bash
set -euo pipefail

TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
LOG_DIR="/var/log/kevin"
LOG_FILE="${LOG_DIR}/server-vuln-scan-${TIMESTAMP}.log"

if [[ "${EUID}" -ne 0 ]]; then
    echo "server-vuln-scan must run as root." >&2
    exit 1
fi

install -d -o root -g root -m 750 "${LOG_DIR}"
touch "${LOG_FILE}"
chown root:root "${LOG_FILE}"
chmod 640 "${LOG_FILE}"

exec > >(tee -a "${LOG_FILE}") 2>&1

section() {
    printf '\n== %s ==\n' "$1"
}

section "OS Release"
cat /etc/os-release || true
uname -r

section "Pending Updates"
apt-get --just-print upgrade | sed -n '/^Inst /p' || true

section "Listening Ports"
ss -tulpn

section "UFW"
if command -v ufw >/dev/null 2>&1; then
    ufw status verbose
else
    echo "ufw not installed"
fi

section "fail2ban"
if command -v fail2ban-client >/dev/null 2>&1; then
    fail2ban-client status
else
    echo "fail2ban-client not installed"
fi

section "SSH Hardening"
if command -v sshd >/dev/null 2>&1; then
    sshd -t
    sshd -T | grep -E '^(passwordauthentication|permitrootlogin|pubkeyauthentication|challengeresponseauthentication|kbdinteractiveauthentication)'
else
    echo "sshd not found"
fi

section "Nginx"
nginx -t || true
systemctl --no-pager --full status nginx || true

section "PHP-FPM"
systemctl --no-pager --full status php8.3-fpm || true

section "TLS Certificate Dates"
if [[ -f /etc/letsencrypt/live/alexlupu.dev/fullchain.pem ]]; then
    openssl x509 -in /etc/letsencrypt/live/alexlupu.dev/fullchain.pem -noout -dates -subject
else
    echo "Wildcard certificate not found"
fi

section "Certbot Timer"
systemctl --no-pager --full status certbot.timer || true

section "World Writable Files"
find /etc /var/www /opt -xdev -type f -perm -0002 -print 2>/dev/null || true

section "SUID SGID Files"
find / -xdev \( -perm -4000 -o -perm -2000 \) -print 2>/dev/null || true

section "Recent Failed SSH Attempts"
journalctl -u ssh --since '7 days ago' --no-pager 2>/dev/null | grep -i 'failed\|invalid\|authentication failure' | tail -n 100 || true

section "Recent fail2ban Activity"
journalctl -u fail2ban --since '7 days ago' --no-pager 2>/dev/null | tail -n 100 || true

section "Audit Tools"
for tool in lynis rkhunter chkrootkit; do
    if command -v "${tool}" >/dev/null 2>&1; then
        echo "${tool}: installed"
    else
        echo "${tool}: not installed"
    fi
done

if command -v lynis >/dev/null 2>&1; then
    section "lynis audit system --quick"
    lynis audit system --quick || true
fi

echo
echo "Scan log written to ${LOG_FILE}"
